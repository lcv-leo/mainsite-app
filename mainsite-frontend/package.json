{
  "name": "mainsite-frontend",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "biome": "biome check .",
    "biome:write": "biome check --write .",
    "test": "node ./scripts/run-vitest.mjs run",
    "test:ui": "node ./scripts/run-vitest.mjs --ui",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "format": "biome format --write src",
    "knip": "knip",
    "stats": "ANALYZE=true vite build",
    "prepare": "husky"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "@tanstack/react-query": "^5.102.8",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "lint-staged": "^17.4.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "4.127.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome format --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "minimatch@^10.0.0": {
      "brace-expansion": "5.0.9"
    },
    "filelist": "2.0.2",
    "picomatch": "4.0.4",
    "unbash": "4.0.9",
    "vite": "$vite",
    "serialize-javascript": "^7.0.5",
    "ws": "8.21.0",
    "source-map": "^0.7.6",
    "workbox-build": {
      "glob": "13.0.6"
    },
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@1.5.5",
    "@babel/core": "7.29.6",
    "fast-uri": "4.1.4"
  }
}
